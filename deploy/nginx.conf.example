# /etc/nginx/sites-available/adbilliards
# Symlink into sites-enabled, then: sudo nginx -t && sudo systemctl reload nginx
# The GitHub Action uploads each build to $EC2_PATH/releases/<stamp> and points $EC2_PATH/current at it.
# TLS: sudo certbot --nginx -d example.com -d www.example.com

server {
    listen 80;
    listen [::]:80;
    server_name adbilliards.example.com;   # TODO: temp subdomain now, real domain later

    root /var/www/adbilliards/current;
    index index.html;

    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    # Astro fingerprints everything in /_astro, so it can be cached forever
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json text/plain application/xml;
}
