---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { business } from '@/data/site';

interface Props {
  crumb: string;
  title: string;
  image: ImageMetadata;
  alt: string;
  cta?: string;
}
const { crumb, title, image, alt, cta = 'Get a free quote' } = Astro.props;
---

<section class="wrap split hero">
  <div class="stack">
    <p class="crumbs"><a href="/">Home</a> / {crumb}</p>
    <h1 class="h1">{title}</h1>
    <p class="lede"><slot /></p>
    <div class="btn-row">
      <a href="/#quote" class="btn">{cta}</a>
      <a href={business.phoneHref} class="btn btn--ghost">{business.phone}</a>
    </div>
  </div>
  <Image src={image} alt={alt} widths={[400, 600, 800]} sizes="(min-width: 900px) 560px, 100vw" class="hero__img" loading="eager" />
</section>

<style>
  .hero {
    padding-top: 56px;
  }
  .hero__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
