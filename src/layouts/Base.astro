---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { business, allCities } from '@/data/site';
import heroPhoto from '@/assets/photos/hero.jpg';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (e.g. FAQPage, Service). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Skip the site header and footer. Used by the standalone /links page. */
  bare?: boolean;
}

const { title, description, schema = [], noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(heroPhoto.src, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: business.name,
  description: 'Pool table moving, refelting, recushioning, installation and pre-owned table sales.',
  url: Astro.site?.href,
  telephone: '+1-440-523-9217',
  email: business.email,
  image: ogImage.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.city,
    addressRegion: business.region,
    postalCode: business.postalCode,
    addressCountry: 'US',
  },
  areaServed: allCities.map((c) => ({ '@type': 'City', name: `${c.name}, OH` })),
  sameAs: [business.facebook, business.google, business.yelp],
};

const jsonLd = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a2a20" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={{ 'is-bare': bare }}>
    <a href="#main" class="skip">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -60px;
    padding: 10px 14px;
    background: var(--brass);
    color: var(--felt-deep);
    font-family: var(--font-display);
    font-weight: 700;
    z-index: 10;
  }
  .skip:focus {
    top: 8px;
  }
  body.is-bare {
    background: var(--felt);
  }
</style>
